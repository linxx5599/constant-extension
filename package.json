{
  "name": "constant-extension",
  "displayName": "constant-extension",
  "description": "Converts the selected content to uppercase",
  "publisher": "constant-extension-linjy",
  "icon": "constant.png",
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:upperCamelCase",
    "onCommand:lowerCamelCase",
    "onCommand:lowerCase",
    "onCommand:upperCase",
    "onCommand:lowerSnakeCase",
    "onCommand:upperSnakeCase",
    "onCommand:lowerKebabCase",
    "onCommand:upperKebabCase",
    "onCommand:copyPathJsonPath",
    "onCommand:copyPathLowerCase",
    "onCommand:copyPathUpperCase",
    "onCommand:copyPathLowerKebabCase",
    "onCommand:copyPathUpperKebabCase",
    "onCommand:copyPathLowerCamelCase",
    "onCommand:copyPathUpperCamelCase",
    "onCommand:copyPathLowerSnakeCase",
    "onCommand:copyPathUpperSnakeCase",
    "onCommand:copyPathJsonPathWithValue",
    "onCommand:copyPathLowerCaseWithValue",
    "onCommand:copyPathUpperCaseWithValue",
    "onCommand:copyPathLowerKebabCaseWithValue",
    "onCommand:copyPathUpperKebabCaseWithValue",
    "onCommand:copyPathLowerCamelCaseWithValue",
    "onCommand:copyPathUpperCamelCaseWithValue",
    "onCommand:copyPathLowerSnakeCaseWithValue",
    "onCommand:copyPathUpperSnakeCaseWithValue"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "upperCamelCase",
        "title": "=> UpperCamelCase"
      },
      {
        "command": "lowerCamelCase",
        "title": "=> lowerCamelCase"
      },
      {
        "command": "lowerCase",
        "title": "=> lowercase"
      },
      {
        "command": "upperCase",
        "title": "=> UPPERCASE"
      },
      {
        "command": "lowerSnakeCase",
        "title": "=> lower_snake_case"
      },
      {
        "command": "upperSnakeCase",
        "title": "=> UPPER_SNAKE_CASE"
      },
      {
        "command": "lowerKebabCase",
        "title": "=> lower-kebab-case"
      },
      {
        "command": "upperKebabCase",
        "title": "=> UPPER-KEBAB-CASE"
      },
      {
        "command": "copyPathJsonPath",
        "title": "=> jsonPath"
      },
      {
        "command": "copyPathLowerCase",
        "title": "=> case"
      },
      {
        "command": "copyPathUpperCase",
        "title": "=> CASE"
      },
      {
        "command": "copyPathLowerKebabCase",
        "title": "=> kebab-case"
      },
      {
        "command": "copyPathUpperKebabCase",
        "title": "=> KEBAB-CASE"
      },
      {
        "command": "copyPathLowerCamelCase",
        "title": "=> lowerCamelCase"
      },
      {
        "command": "copyPathUpperCamelCase",
        "title": "=> UpperCamelCase"
      },
      {
        "command": "copyPathLowerSnakeCase",
        "title": "=> lower_snake_case"
      },
      {
        "command": "copyPathUpperSnakeCase",
        "title": "=> UPPER_SNAKE_CASE"
      },
      {
        "command": "copyPathJsonPathWithValue",
        "title": "=> jsonPath"
      },
      {
        "command": "copyPathLowerCaseWithValue",
        "title": "=> case"
      },
      {
        "command": "copyPathUpperCaseWithValue",
        "title": "=> CASE"
      },
      {
        "command": "copyPathLowerKebabCaseWithValue",
        "title": "=> kebab-case"
      },
      {
        "command": "copyPathUpperKebabCaseWithValue",
        "title": "=> KEBAB-CASE"
      },
      {
        "command": "copyPathLowerCamelCaseWithValue",
        "title": "=> lowerCamelCase"
      },
      {
        "command": "copyPathUpperCamelCaseWithValue",
        "title": "=> UpperCamelCase"
      },
      {
        "command": "copyPathLowerSnakeCaseWithValue",
        "title": "=> lower_snake_case"
      },
      {
        "command": "copyPathUpperSnakeCaseWithValue",
        "title": "=> UPPER_SNAKE_CASE"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection && (resourceLangId == 'yaml' || resourceLangId == 'yml' || resourceLangId == 'json')",
          "group": "navigation@1",
          "submenu": "copyPathMenu"
        },
        {
          "group": "navigation@2",
          "submenu": "root"
        }
      ],
      "copyPathMenu": [
        {
          "group": "copyPath@1",
          "command": "copyPathJsonPath"
        },
        {
          "group": "copyPath@2",
          "command": "copyPathLowerCase"
        },
        {
          "group": "copyPath@3",
          "command": "copyPathUpperCase"
        },
        {
          "group": "copyPath@4",
          "command": "copyPathLowerKebabCase"
        },
        {
          "group": "copyPath@5",
          "command": "copyPathUpperKebabCase"
        },
        {
          "group": "copyPath@6",
          "command": "copyPathLowerCamelCase"
        },
        {
          "group": "copyPath@7",
          "command": "copyPathUpperCamelCase"
        },
        {
          "group": "copyPath@8",
          "command": "copyPathLowerSnakeCase"
        },
        {
          "group": "copyPath@9",
          "command": "copyPathUpperSnakeCase"
        },
        {
          "group": "copyPath@10",
          "submenu": "copyPathWithValueMenu"
        }
      ],
      "root": [
        {
          "command": "upperCamelCase",
          "group": "rename"
        },
        {
          "command": "lowerCamelCase",
          "group": "rename"
        },
        {
          "command": "lowerCase",
          "group": "rename"
        },
        {
          "command": "upperCase",
          "group": "rename"
        },
        {
          "command": "lowerSnakeCase",
          "group": "rename"
        },
        {
          "command": "upperSnakeCase",
          "group": "rename"
        },
        {
          "command": "lowerKebabCase",
          "group": "rename"
        },
        {
          "command": "upperKebabCase",
          "group": "rename"
        }
      ],
      "copyPathWithValueMenu": [
        {
          "group": "copyPathWithValue@1",
          "command": "copyPathJsonPathWithValue"
        },
        {
          "group": "copyPathWithValue@2",
          "command": "copyPathLowerCaseWithValue"
        },
        {
          "group": "copyPathWithValue@3",
          "command": "copyPathUpperCaseWithValue"
        },
        {
          "group": "copyPathWithValue@4",
          "command": "copyPathLowerKebabCaseWithValue"
        },
        {
          "group": "copyPathWithValue@5",
          "command": "copyPathUpperKebabCaseWithValue"
        },
        {
          "group": "copyPathWithValue@6",
          "command": "copyPathLowerCamelCaseWithValue"
        },
        {
          "group": "copyPathWithValue@7",
          "command": "copyPathUpperCamelCaseWithValue"
        },
        {
          "group": "copyPathWithValue@8",
          "command": "copyPathLowerSnakeCaseWithValue"
        },
        {
          "group": "copyPathWithValue@9",
          "command": "copyPathUpperSnakeCaseWithValue"
        }
      ]
    },
    "submenus": [
      {
        "id": "root",
        "label": "Rename"
      },
      {
        "id": "copyPathMenu",
        "label": "CopyPath"
      },
      {
        "id": "copyPathWithValueMenu",
        "label": "WithValue"
      }
    ],
    "keybindings": [
      {
        "command": "upperSnakeCase",
        "key": "ctrl+alt+q",
        "mac": "cmd+alt+q"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "pnpm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "wordsninja": "^1.0.0",
    "yaml": "^2.7.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linxx5599/constant-extension.git"
  }
}
